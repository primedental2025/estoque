    function renderVariacoesLista(){
      const m = acharMaterial(variacoesCtx.id); const vs = (m && m.variacoes) || []; const un = (m && m.unidadeMedida) || 'unidades';
      let html = '';
      if (!vs.length) html += `<p class="text-sm text-gray-500">Nenhuma variação cadastrada. Cadastre abaixo as marcas/embalagens que você costuma comprar deste item.</p>`;
      html += vs.map(v => { const uso = variacoesCtx.uso[v.id] || 0; return `
        <div class="flex items-center justify-between gap-3 p-2 border border-gray-200 rounded-lg">
