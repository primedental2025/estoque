        renderVariacoesLista();
      } catch (err) { console.error(err); }
    });

    // Grava uma compra no histórico do material
    async function registrarEntradaEmMaterialExistente(id, item, origem, variacao = null){
      const ref=db.collection('materiais').doc(id);
      const agoraISO=new Date().toISOString();
      const dataCompraISO = item.dataCompra || new Date().toISOString();
      await ref.collection('compras').add({
        origem: origem || 'manual',
        dataCompra: dataCompraISO,
        qtd: item.qtd || 0,
        precoUnit: item.preco || 0,
        total: (item.qtd||0) * (item.preco||0),
        lote: item.lote || null,
        validade: item.validade || null,
        ean: item.ean || null,
        loja: item.loja || null,
        numeroNF: item.nf || null,
        criadoEm: agoraISO,
        variacaoId: variacao ? variacao.id : null,
        variacao: variacao ? (rotuloVariacao(variacao) || null) : null,
        conteudo: variacao && variacao.conteudo != null ? Number(variacao.conteudo) : null,
        chaveNFe: item.chave || null,
        nItem: item.nItem || null,
        codigoProduto: item.cod || null,
        cnpjEmitente: item.cnpj || null,
        descricaoNota: origem !== 'manual' ? (item.nome || null) : null,
        unidadeNota: item.uCom || null
      });
    }

    // ---------- COMPRAS MANUAIS ----------
