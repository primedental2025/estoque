  <script>
  document.addEventListener('DOMContentLoaded', function() {
    // Firebase
    if (typeof firebase === 'undefined') { alert('Firebase SDK não carregou.'); return; }
    const firebaseConfig = {
      apiKey: "AIzaSyCDxJW_o6y-hmisQHOHVYPVJ8cag6hrKv0",
