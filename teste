            <div class="font-medium text-text-dark break-words">${esc(rotuloVariacao(v) || '(sem nome)')}</div>
            <div class="text-xs text-gray-500">${v.conteudo ? `${esc(fmtNum(v.conteudo))} ${esc(un)} por embalagem · ` : ''}${plural(uso, 'compra', 'compras')}${(v.codigos || []).length ? ' · reconhecida nas notas fiscais' : ''}</div>
          </div>
          <div class="flex gap-3 text-sm flex-shrink-0">
            <button type="button" class="text-primary-dark underline" data-acao="editar" data-id="${esc(v.id)}">Editar</button>
            <button type="button" class="${uso ? 'text-gray-300 cursor-not-allowed' : 'text-danger-red underline'}" data-acao="excluir" data-id="${esc(v.id)}" ${uso ? 'disabled title="Há compras com esta variação"' : ''}>Excluir</button>
          </div>
        </div>`; }).join('');
      if (variacoesCtx.semVariacao) html += `<p class="text-xs text-gray-500 pt-1">${plural(variacoesCtx.semVariacao, 'compra está', 'compras estão')} sem marca/embalagem. Para indicar, abra o Histórico de compras e use Editar.</p>`;
      variacoesLista.innerHTML = html;
    }
    async function alterarVariacoes(materialId, transformar){
      const ref = db.collection('materiais').doc(materialId);
      const atual = (await ref.get()).data() || {};
      const variacoes = transformar(atual.variacoes || []);
      await ref.update({ variacoes });
      sincronizarMaterialLocal(materialId, { variacoes });
      await recomputarAgregados(materialId);
    }
    variacoesLista.addEventListener('click', async (e) => {
      const b = e.target.closest('button[data-acao]'); if (!b || b.disabled) return;
      const m = acharMaterial(variacoesCtx.id); const v = ((m && m.variacoes) || []).find(x => x.id === b.dataset.id); if (!v) return;
      if (b.dataset.acao === 'editar') {
        variacaoEditId.value = v.id; variacaoMarca.value = v.marca || ''; variacaoDescricao.value = v.descricao || ''; variacaoConteudo.value = v.conteudo ?? '';
