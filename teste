    };
    const app = firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
    const auth = firebase.auth();

    // Aviso de "versão de teste" quando a página aberta é teste.html
    if (/teste\.html$/i.test(location.pathname)) document.getElementById('bannerTeste').classList.remove('hidden');

    // categorias
    const categorias = {
      biosseguranca:"Biossegurança", brocas:"Brocas", cirurgia:"Cirurgia", clinica_geral:"Clínica Geral",
      dentistica:"Dentística", endodontia:"Endodontia", instrumental:"Instrumental", material_limpeza:"Material de Limpeza",
      ortodontia:"Ortodontia", papelaria:"Papelaria", protese:"Prótese", implantodontia:"Implantodontia"
    };
    const DIAS_ALERTA_VALIDADE = 60;

    let todosMateriais = [];        // cópia local de todos os materiais (evita baixar tudo a cada clique)
    let materiaisFiltrados = [];
    let termoDeBusca = "";
    let categoriaSelecionada = "todos";
    let filtroEspecial = null;      // 'vencendo' | 'abaixoMinimo' | 'arquivados'
    let isShowingPurchaseList = false;
    // Estado do histórico
    let historicoContext = { id: null, nome: null, compras: [], editId: null, variacoes: [], unidadeMedida: '' };

    // ---------- UTILITÁRIOS ----------
    function showCustomModal(title, message, type, copyText='') {
      return new Promise((resolve) => {
        const modal = document.getElementById('customModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalMessage = document.getElementById('modalMessage');
        const modalActions = document.getElementById('modalActions');
        modalTitle.textContent = title; modalMessage.innerHTML=''; modalActions.innerHTML='';
        if (type==='alert') {
          modalMessage.textContent = message;
          const ok=document.createElement('button'); ok.textContent='OK';
          ok.className='bg-primary-dark text-white py-2 px-4 rounded-lg hover:bg-opacity-90 transition';
          ok.onclick=()=>{ modal.classList.add('hidden'); resolve(true); }; modalActions.appendChild(ok);
        } else if (type==='confirm') {
          modalMessage.textContent = message;
          const yes=document.createElement('button'); yes.textContent='Sim';
          yes.className='bg-green-600 text-white py-2 px-4 rounded-lg hover:bg-green-700 transition';
          yes.onclick=()=>{ modal.classList.add('hidden'); resolve(true); }; modalActions.appendChild(yes);
          const no=document.createElement('button'); no.textContent='Não';
          no.className='bg-danger-red text-white py-2 px-4 rounded-lg hover:bg-red-700 transition';
          no.onclick=()=>{ modal.classList.add('hidden'); resolve(false); }; modalActions.appendChild(no);
        } else if (type==='copy') {
          modalMessage.textContent = message;
          const ta=document.createElement('textarea'); ta.value=copyText;
          ta.readOnly=true;
          ta.className='w-full h-32 p-2 border border-gray-300 rounded-lg resize-none mb-4 font-mono text-sm';
          modalMessage.appendChild(ta);
          const close=document.createElement('button'); close.textContent='Fechar';
          close.className='bg-primary-dark text-white py-2 px-4 rounded-lg hover:bg-opacity-90 transition';
          close.onclick=()=>{ modal.classList.add('hidden'); resolve(false); }; modalActions.appendChild(close);
          ta.focus(); ta.select(); ta.setSelectionRange(0, ta.value.length);
        }
        modal.classList.remove('hidden');
      });
    }
    function converterParaDataURL(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=e=>rej(e);r.readAsDataURL(file);});}
    const fmtMoeda = (v)=> (v==null?'-':Number(v).toFixed(2).replace('.',','));
    const fmtNum = v => (v === null || v === undefined || v === '') ? '' : Number(v).toLocaleString('pt-BR', { maximumFractionDigits: 3 });
    function fmtPrecoUnidade(v){
      if (v === null || v === undefined || !isFinite(v)) return '-';
      return 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: v < 1 ? 4 : 2 });
    }
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    function toBRDate(dStr){
      if(!dStr) return 'N/A';
      const br = String(dStr).match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);   // datas já gravadas como DD/MM/AAAA
      if (br) return `${br[1].padStart(2,'0')}/${br[2].padStart(2,'0')}/${br[3]}`;
      const d = new Date(dStr);
      if(!isNaN(d)) return d.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
      const p=String(dStr).split('T')[0];
      if(p && p.includes('-')){ const [y,m,da]=p.split('-'); return `${da}/${m}/${y}`;}
      return dStr;
    }
    function toISODateInput(dStr){ if(!dStr) return ''; const d=new Date(dStr); if(!isNaN(d)) return d.toISOString().slice(0,10); const p=String(dStr).split('T')[0]; return p||'';
    }
    const isFuture = (iso)=> iso && new Date(iso).getTime() >= (new Date().setHours(0,0,0,0));
    function diasAte(dStr){
      if (!dStr) return null;
      const dt = new Date(dStr); if (isNaN(dt)) return null;
      const hoje = new Date();
      return Math.round((Date.UTC(dt.getUTCFullYear(), dt.getUTCMonth(), dt.getUTCDate()) - Date.UTC(hoje.getFullYear(), hoje.getMonth(), hoje.getDate())) / 86400000);
    }
    // número opcional digitado: '' → null, inválido → NaN
    function numOpcional(v){
      const s = String(v ?? '').trim().replace(',', '.');
      if (s === '') return null;
      const n = Number(s);
      return Number.isFinite(n) && n >= 0 ? n : NaN;
    }
    const temMinimo = m => m && m.estoqueMinimo !== null && m.estoqueMinimo !== undefined && m.estoqueMinimo !== '';
    const abaixoDoMinimo = m => temMinimo(m) && m.contagemAtual !== null && m.contagemAtual !== undefined && Number(m.contagemAtual) <= Number(m.estoqueMinimo);
    const venceEmBreve = m => { const d = diasAte(m.validadeUltimaCompra); return d !== null && d <= DIAS_ALERTA_VALIDADE; };
    const acharMaterial = id => todosMateriais.find(m => m.id === id);
    const rotuloVariacao = v => v ? [v.marca, v.descricao].filter(Boolean).join(' · ') : '';
    const novoIdVariacao = () => 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
    const plural = (n, um, varios) => `${n} ${n === 1 ? um : varios}`;

    // Reduz a foto para no máximo 400 px antes de salvar (fica ~20–40 KB em vez de até 500 KB)
    async function prepararImagem(file){
      const original = await converterParaDataURL(file);
      const img = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = () => rej(new Error('Não foi possível ler esta imagem. Tente uma foto em JPG ou PNG.')); i.src = original; });
      const MAX = 400;
      const escala = Math.min(1, MAX / Math.max(img.width, img.height));
      const w = Math.max(1, Math.round(img.width * escala)), h = Math.max(1, Math.round(img.height * escala));
      const canvas = document.createElement('canvas'); canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext('2d'); ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, w, h); ctx.drawImage(img, 0, 0, w, h);
      let resultado = canvas.toDataURL('image/jpeg', 0.8);
      if (resultado.length > original.length) resultado = original;   // a original já era menor
      if (resultado.length > 700000) throw new Error('A imagem continua grande demais mesmo reduzida.');
      return resultado;
    }

    // Campos padrão de um material novo
    function novoMaterialBase(id, nome, categoria, extra = {}){
      return {
        id, nome, categoria,
        quantidade: 0, imagem: null,
        ultimaModificacao: new Date().toLocaleString('pt-BR'),
        marcadoParaCompraEm: null, ultimaCompraEm: null, validadeUltimaCompra: null,
        precoCompra: null, lojaUltimaCompra: null, nfUltimaCompra: null,
        variacoes: [], codigos: [], arquivado: false,
        unidadeContagem: null, estoqueMinimo: null, contagemAtual: null, contagemEm: null,
        ...extra
      };
    }

    // ---------- CARREGAR / FILTRAR / MOSTRAR ----------
    async function carregarMateriais(){
      try{
        const snap = await db.collection('materiais').get();
        const todos = []; snap.forEach(doc => todos.push({ id: doc.id, ...doc.data() }));
        todosMateriais = todos;
        renderizar();
      }catch(e){ console.error(e); showCustomModal('Erro','Erro ao carregar materiais: '+e.message,'alert');}
    }

    function materiaisVisiveis(){
      const verArquivados = filtroEspecial === 'arquivados' && !isShowingPurchaseList;
      let lista = todosMateriais.filter(m => verArquivados ? !!m.arquivado : !m.arquivado);
      if (isShowingPurchaseList) return lista.filter(m => !!m.marcadoParaCompraEm);
      if (filtroEspecial === 'vencendo') lista = lista.filter(venceEmBreve);
      if (filtroEspecial === 'abaixoMinimo') lista = lista.filter(abaixoDoMinimo);
      if (categoriaSelecionada !== 'todos') lista = lista.filter(m => m.categoria === categoriaSelecionada);
      const t = norm(termoDeBusca);
      if (t) lista = lista.filter(m => norm(m.nome).includes(t) || (m.variacoes || []).some(v => norm(rotuloVariacao(v)).includes(t)));
      return lista;
    }

    function renderizar(){
      materiaisFiltrados = materiaisVisiveis();
      atualizarLista(materiaisFiltrados);
      renderizarCategorias(todosMateriais);
      togglePurchaseListActionsVisibility();
    }

    function renderizarCategorias(all){
      const box=document.getElementById('categorySidebar'); box.innerHTML='';
      const ativos = all.filter(m => !m.arquivado);
      const set=new Set(); ativos.forEach(m=>set.add(m.categoria));
      const botao = (texto, ativo, onclick) => {
        const b=document.createElement('button'); b.textContent=texto;
        b.className=`w-full text-left py-2 px-4 rounded-lg ${ativo ? 'bg-primary-dark text-white':'bg-gray-200 text-text-dark hover:bg-gray-300'}`;
        b.onclick=onclick; box.appendChild(b); return b;
      };
      const semEspecial = !filtroEspecial && !isShowingPurchaseList;
      botao('Todos', semEspecial && categoriaSelecionada==='todos', ()=>{ categoriaSelecionada='todos'; filtroEspecial=null; isShowingPurchaseList=false; renderizar(); });
      Array.from(set).sort().forEach(cat=>{
        botao(categorias[cat]||cat||'Sem categoria', semEspecial && categoriaSelecionada===cat, ()=>{ categoriaSelecionada=cat; filtroEspecial=null; isShowingPurchaseList=false; renderizar(); });
      });
      const sep = document.createElement('div');
      sep.className = 'pt-3 mt-3 border-t border-gray-200 text-xs font-bold uppercase text-gray-500';
      sep.textContent = 'Atenção'; box.appendChild(sep);
      const especial = (chave, texto) => botao(texto, filtroEspecial===chave && !isShowingPurchaseList, ()=>{ filtroEspecial=chave; categoriaSelecionada='todos'; isShowingPurchaseList=false; renderizar(); });
      especial('vencendo', `⏳ Validade em até ${DIAS_ALERTA_VALIDADE} dias (${ativos.filter(venceEmBreve).length})`);
      especial('abaixoMinimo', `📉 Abaixo do mínimo (${ativos.filter(abaixoDoMinimo).length})`);
      especial('arquivados', `🗄️ Arquivados (${all.length - ativos.length})`);
    }
    function togglePurchaseListActionsVisibility(){
      const c=document.getElementById('purchaseListActionsContainer'); if(isShowingPurchaseList) c.classList.remove('hidden'); else c.classList.add('hidden');
    }

