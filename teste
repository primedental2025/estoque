    // ---------- HISTÓRICO ----------
    const historicoModal=document.getElementById('historicoModal');
    const historicoTitulo=document.getElementById('historicoTitulo');
    const historicoTabela=document.getElementById('historicoTabela');
    const btnExportarHistorico=document.getElementById('btnExportarHistorico');
    document.getElementById('btnFecharHistorico').addEventListener('click', ()=>historicoModal.classList.add('hidden'));

    async function abrirHistoricoCompras(id, nome){
      const m = acharMaterial(id);
      historicoContext = { id, nome, compras: [], editId: null, variacoes: (m && m.variacoes) || [], unidadeMedida: (m && m.unidadeMedida) || '' };
      historicoTitulo.textContent = `Produto: ${nome}` + (historicoContext.unidadeMedida ? ` · Preço/unid. = preço por ${historicoContext.unidadeMedida}` : '');
      historicoTabela.innerHTML = '<tr><td class="p-2 border text-center text-gray-500" colspan="12">Carregando...</td></tr>';
      historicoModal.classList.remove('hidden');
      try{
        const snap = await db.collection('materiais').doc(id).collection('compras').orderBy('dataCompra','desc').limit(500).get();
        if (snap.empty){ historicoTabela.innerHTML = '<tr><td class="p-2 border text-center text-gray-500" colspan="12">Sem registros.</td></tr>'; return;
        }
        let rows=[]; snap.forEach(doc=>rows.push({ id:doc.id, ...doc.data() }));
        historicoContext.compras = rows;
        renderTabelaHistorico(rows);
      }catch(err){
        console.error(err);
        historicoTabela.innerHTML = '<tr><td class="p-2 border text-center text-danger-red" colspan="12">Erro ao carregar.</td></tr>';
      }
    }

    function renderTabelaHistorico(rows){
      const vs = historicoContext.variacoes;
      const calc = r => {
        const cont = conteudoDaCompra(r, vs);
        const preco = Number(r.precoUnit);
        return { rot: rotuloDaCompra(r, vs), pu: cont > 0 && preco > 0 ? preco / cont : null, total: r.total!=null ? r.total : (r.qtd||0)*(r.precoUnit||0) };
      };
      historicoTabela.innerHTML = rows.map(r=>{ const k = calc(r); return `
        <tr data-id="${esc(r.id)}">
          <td class="p-2 border">${esc(toBRDate(r.dataCompra))}</td>
          <td class="p-2 border">${k.rot ? esc(k.rot) : '<span class="text-gray-400">—</span>'}</td>
          <td class="p-2 border text-right">${esc(fmtNum(r.qtd))}</td>
          <td class="p-2 border text-right">R$ ${fmtMoeda(r.precoUnit)}</td>
          <td class="p-2 border text-right">${k.pu != null ? esc(fmtPrecoUnidade(k.pu)) : ''}</td>
          <td class="p-2 border text-right">R$ ${fmtMoeda(k.total)}</td>
          <td class="p-2 border">${esc(r.lote || '')}</td>
          <td class="p-2 border">${r.validade ? esc(toBRDate(r.validade)) : ''}</td>
          <td class="p-2 border">${esc(r.loja || '')}</td>
          <td class="p-2 border">${esc(r.numeroNF || '')}</td>
          <td class="p-2 border">${esc(r.origem || '')}</td>
          <td class="p-2 border whitespace-nowrap">
            <button class="text-primary-dark underline mr-2" onclick="window._editarCompra('${esc(r.id)}')">Editar</button>
            <button class="text-danger-red underline" onclick="window._excluirCompra('${esc(r.id)}')">Excluir</button>
          </td>
        </tr>`; }).join('');
      btnExportarHistorico.onclick = ()=>{
        const header = 'Data;Marca/embalagem;Qtd;PrecoUnit;PrecoPorUnidade;Total;Lote;Validade;Loja;NF;Origem\n';
        const csv = header + rows.map(r=>{ const k = calc(r); return [
          toBRDate(r.dataCompra), k.rot, r.qtd, r.precoUnit, k.pu != null ? k.pu : '', k.total,
          r.lote||'', (r.validade?toBRDate(r.validade):''), r.loja||'', r.numeroNF||'', r.origem||''
        ].map(x=>String(x).replaceAll(';',',')).join(';'); }).join('\n');
        const blob = new Blob(['﻿' + csv], {type:'text/csv;charset=utf-8;'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `historico_${historicoContext.nome}.csv`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 30000);
      };
    }

    const editarCompraModal = document.getElementById('editarCompraModal');
