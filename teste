    async function iniciarFluxoConferencia() {
      const cat = document.getElementById('confSelectCategoria').value;
      const btn = document.getElementById('btnComecarFluxo'); btn.disabled = true;
      try {
        await carregarMateriais();
        itensParaConferir = todosMateriais
          .filter(m => !m.arquivado && (cat === 'todos' || m.categoria === cat))
          .sort((a,b) => String(a.nome||'').localeCompare(String(b.nome||''), 'pt-BR'));
        if (itensParaConferir.length === 0) {
          document.getElementById('confMsgSelecao').textContent = 'Nenhum item nesta categoria.';
          return;
        }
        indexItemAtual = 0;
        respostasConferencia = [];
        alternarTelasConferencia('card');
        renderizarItemAtual();
      } finally { btn.disabled = false; }
    }

    function lerContagem(){
      if (confContagem.validity && confContagem.validity.badInput) return NaN;
      return numOpcional(confContagem.value);
    }
    function atualizarDicaContagem(){
      const item = itensParaConferir[indexItemAtual]; if (!item) return;
      const n = lerContagem();
      let txt, cls = 'text-gray-500';
      if (n === null) txt = temMinimo(item) ? 'Digite a quantidade contada e tecle Enter, ou escolha abaixo.' : 'Digite a quantidade contada (opcional) e escolha abaixo.';
      else if (Number.isNaN(n)) { txt = 'Quantidade inválida.'; cls = 'text-danger-red font-semibold'; }
      else if (!temMinimo(item)) txt = 'Este item não tem estoque mínimo definido: escolha Falta ou OK.';
      else if (n <= Number(item.estoqueMinimo)) { txt = `Igual ou abaixo do mínimo (${fmtNum(item.estoqueMinimo)}): vai para a lista de compras. Tecle Enter.`; cls = 'text-red-700 font-semibold'; }
      else { txt = `Acima do mínimo (${fmtNum(item.estoqueMinimo)}): estoque OK. Tecle Enter.`; cls = 'text-emerald-700 font-semibold'; }
      confDica.textContent = txt;
      confDica.className = `text-xs text-center mb-3 min-h-[1rem] ${cls}`;
    }

    function renderizarItemAtual() {
      if (indexItemAtual >= itensParaConferir.length) {
        exibirResumoConferencia();
        return;
      }
      const item = itensParaConferir[indexItemAtual];
      const un = item.unidadeContagem || 'un';
      document.getElementById('confBadgeCategoria').innerText = categorias[item.categoria] || item.categoria || 'Geral';
      document.getElementById('confNomeItem').innerText = item.nome;
      const info = [item.contagemAtual !== null && item.contagemAtual !== undefined
        ? `Última contagem: ${fmtNum(item.contagemAtual)} ${un} em ${toBRDate(item.contagemEm)}`
        : 'Ainda não contado'];
      if (temMinimo(item)) info.push(`mínimo: ${fmtNum(item.estoqueMinimo)} ${un}`);
      document.getElementById('confInfoEstoque').innerText = info.join(' · ');
      document.getElementById('confUnidade').textContent = un;
      const resp = respostasConferencia[indexItemAtual];
      confContagem.value = resp && resp.contagem !== null && resp.contagem !== undefined ? resp.contagem : '';
      atualizarDicaContagem();

      const imgPlaceholder = 'https://placehold.co/300x300/BFBFBF/585856?text=Sem+Imagem';
      document.getElementById('confImgItem').src = item.imagem || imgPlaceholder;

      const total = itensParaConferir.length;
      const atual = indexItemAtual + 1;
      document.getElementById('confProgressoTexto').innerText = `Item ${atual} de ${total}`;
      const porcentagem = (atual / total) * 100;
      document.getElementById('confBarraProgresso').style.width = `${porcentagem}%`;
      document.getElementById('btnConfVoltar').disabled = (indexItemAtual === 0);
      if (!window.matchMedia || !window.matchMedia('(pointer: coarse)').matches) setTimeout(() => confContagem.focus(), 30);
    }

    function registrarDecisao(precisaComprar) {
      const item = itensParaConferir[indexItemAtual];
      if (!item) return;
      const contagem = lerContagem();
      if (Number.isNaN(contagem)) { atualizarDicaContagem(); return; }
      respostasConferencia[indexItemAtual] = { id: item.id, nome: item.nome, precisaComprar, contagem, unidade: item.unidadeContagem || 'un' };
      indexItemAtual++;
      renderizarItemAtual();
    }
    function pularItem() {
      indexItemAtual++;
      renderizarItemAtual();
    }
    function voltarItem() {
      if (indexItemAtual > 0) {
        indexItemAtual--;
        renderizarItemAtual();
      }
    }
    confContagem.addEventListener('input', atualizarDicaContagem);
    confContagem.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const item = itensParaConferir[indexItemAtual];
      const n = lerContagem();
      if (!item || n === null || Number.isNaN(n) || !temMinimo(item)) { atualizarDicaContagem(); return; }
      registrarDecisao(n <= Number(item.estoqueMinimo));
    });

    function exibirResumoConferencia() {
      alternarTelasConferencia('resumo');
      const containerResumo = document.getElementById('confListaResumo');
      containerResumo.innerHTML = '';
      let itensContabilizados = 0;
      respostasConferencia.forEach(resp => {
        if (!resp) return;
        const row = document.createElement('div');
        row.className = 'flex justify-between items-center gap-2 p-2 bg-white rounded border border-gray-100 shadow-sm text-xs font-medium';
        const tag = resp.precisaComprar
          ? '<span class="px-2 py-0.5 rounded bg-red-100 text-red-700 font-bold uppercase text-[10px] flex-shrink-0">Falta / Comprar</span>'
          : '<span class="px-2 py-0.5 rounded bg-green-100 text-green-700 font-bold uppercase text-[10px] flex-shrink-0">OK</span>';
        const cont = resp.contagem !== null && resp.contagem !== undefined ? ` <span class="text-gray-500">(contado: ${esc(fmtNum(resp.contagem))} ${esc(resp.unidade)})</span>` : '';
        row.innerHTML = `<span class="text-text-dark">${esc(resp.nome)}${cont}</span> ${tag}`;
        containerResumo.appendChild(row);
        itensContabilizados++;
      });
      if (itensContabilizados === 0) {
        containerResumo.innerHTML = '<p class="text-gray-400 text-center py-4 text-xs">Nenhum item recebeu nova marcação.</p>';
      }
    }

    async function salvarDadosConferencia() {
      const agora = new Date().toISOString();
      const atualizacoes = [];
      respostasConferencia.forEach(resp => {
        if (!resp) return;
        const m = acharMaterial(resp.id);
        const upd = { marcadoParaCompraEm: resp.precisaComprar ? ((m && m.marcadoParaCompraEm) || agora) : null };
        if (resp.contagem !== null && resp.contagem !== undefined) { upd.contagemAtual = resp.contagem; upd.contagemEm = agora; }
        atualizacoes.push([resp.id, upd]);
      });
      if (atualizacoes.length === 0) {
        fecharModalConferencia();
        return;
      }
      const btn = document.getElementById('btnConfSalvar'); btn.disabled = true;
      try {
        for (let i = 0; i < atualizacoes.length; i += 400) {
          const batch = db.batch();
          atualizacoes.slice(i, i + 400).forEach(([id, upd]) => batch.update(db.collection('materiais').doc(id), upd));
          await batch.commit();
        }
        atualizacoes.forEach(([id, upd]) => { const m = acharMaterial(id); if (m) Object.assign(m, upd); });
        const nComprar = atualizacoes.filter(([, u]) => u.marcadoParaCompraEm).length;
        const nContados = atualizacoes.filter(([, u]) => u.contagemAtual !== undefined).length;
        fecharModalConferencia();
        renderizar();
        showCustomModal('Conferência gravada',
          `${plural(atualizacoes.length, 'item atualizado', 'itens atualizados')}${nContados ? ` (${nContados} com contagem)` : ''}.\n${plural(nComprar, 'item está', 'itens estão')} na lista de compras.`, 'alert');
      } catch (error) {
        console.error("Erro ao gravar a conferência:", error);
        showCustomModal('Erro', 'Ocorreu um erro ao gravar a conferência: ' + error.message, 'alert');
      } finally { btn.disabled = false; }
    }

    // ---------- BACKUP COMPLETO ----------
    // Apenas LÊ o banco de dados: nada é alterado ou apagado.
    const backupModal = document.getElementById('backupModal');
    const backupStatus = document.getElementById('backupStatus');
    const backupResumo = document.getElementById('backupResumo');
    const backupAcoes = document.getElementById('backupAcoes');
    const btnBaixarBackupJson = document.getElementById('btnBaixarBackupJson');
    const btnBaixarBackupXlsx = document.getElementById('btnBaixarBackupXlsx');
    let backup = null;              // { dados, json, carimbo }
    let backupEmAndamento = false;

    // Converte tipos especiais do Firestore (datas, referências) para algo que cabe num JSON
    function paraJSONSeguro(v){
      if (v === null || v === undefined) return null;
      if (Array.isArray(v)) return v.map(paraJSONSeguro);
      if (typeof v === 'object'){
        if (typeof v.toDate === 'function' && typeof v.seconds === 'number') return { __tipo: 'timestamp', iso: v.toDate().toISOString() };
        if (typeof v.latitude === 'number' && typeof v.longitude === 'number') return { __tipo: 'geopoint', latitude: v.latitude, longitude: v.longitude };
        if (typeof v.path === 'string' && v.firestore) return { __tipo: 'referencia', caminho: v.path };
        const out = {};
        Object.keys(v).forEach(k => { out[k] = paraJSONSeguro(v[k]); });
        return out;
      }
      return v;
    }

    async function coletarBackup(avisar){
      avisar('Lendo materiais…');
      const matSnap = await db.collection('materiais').get();
      const materiais = [];
      const porId = new Map();
      matSnap.forEach(doc => {
        const m = { id: doc.id, dados: paraJSONSeguro(doc.data()), compras: [] };
        materiais.push(m);
        porId.set(doc.id, m);
      });

      let comprasDeItensExcluidos = [];
      try {
        // Uma única leitura de todas as compras (inclui compras de itens que já foram excluídos)
        avisar('Lendo histórico de compras…');
        const grupo = await db.collectionGroup('compras').get();
        grupo.forEach(doc => {
          const pai = doc.ref.parent.parent;
          if (!pai || pai.parent.id !== 'materiais') return;
          const reg = { id: doc.id, dados: paraJSONSeguro(doc.data()) };
          const m = porId.get(pai.id);
          if (m) m.compras.push(reg);
          else comprasDeItensExcluidos.push({ materialId: pai.id, ...reg });
        });
      } catch (e) {
        // Se a leitura em grupo não for permitida, lê item por item (10 de cada vez)
        console.warn('Leitura em grupo indisponível; lendo item por item.', e);
        comprasDeItensExcluidos = [];
        let feitos = 0;
        for (let i = 0; i < materiais.length; i += 10){
          const lote = materiais.slice(i, i + 10);
          await Promise.all(lote.map(async m => {
            const s = await db.collection('materiais').doc(m.id).collection('compras').get();
            m.compras = [];
            s.forEach(doc => m.compras.push({ id: doc.id, dados: paraJSONSeguro(doc.data()) }));
          }));
          feitos += lote.length;
          avisar(`Lendo histórico de compras: ${feitos} de ${materiais.length} itens…`);
        }
      }

      const nfesImportadas = [];
      try {
        avisar('Lendo registro de notas importadas…');
        const s = await db.collection('nfesImportadas').get();
        s.forEach(doc => nfesImportadas.push({ id: doc.id, dados: paraJSONSeguro(doc.data()) }));
      } catch (e) { console.warn('Não foi possível ler nfesImportadas', e); }

      const maisRecentePrimeiro = (a, b) => String(b.dados.dataCompra || '').localeCompare(String(a.dados.dataCompra || ''));
      materiais.sort((a, b) => String(a.dados.nome || '').localeCompare(String(b.dados.nome || ''), 'pt-BR'));
      materiais.forEach(m => m.compras.sort(maisRecentePrimeiro));
      comprasDeItensExcluidos.sort(maisRecentePrimeiro);

      return {
        tipo: 'backup-controle-estoque',
        versaoFormato: 2,
        projetoFirebase: firebaseConfig.projectId,
        geradoEm: new Date().toISOString(),
        totais: {
          materiais: materiais.length,
          materiaisArquivados: materiais.filter(m => !!m.dados.arquivado).length,
          materiaisComFoto: materiais.filter(m => !!m.dados.imagem).length,
          variacoes: materiais.reduce((s, m) => s + ((m.dados.variacoes || []).length), 0),
          compras: materiais.reduce((s, m) => s + m.compras.length, 0),
          comprasDeItensExcluidos: comprasDeItensExcluidos.length,
          nfesImportadas: nfesImportadas.length
        },
        materiais,
        comprasDeItensExcluidos,
        nfesImportadas
      };
    }

    // Datas do banco (ISO, AAAA-MM-DD ou DD/MM/AAAA) → data do Excel (mesmo dia mostrado no site)
    function dataParaExcel(valor){
      if (valor === null || valor === undefined || valor === '') return null;
      if (typeof valor === 'object' && valor.iso) valor = valor.iso;
      const s = String(valor).trim();
      let y, m, d, x;
      if ((x = s.match(/^(\d{4})-(\d{2})-(\d{2})$/))) { y = +x[1]; m = +x[2]; d = +x[3]; }
      else if ((x = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/))) { d = +x[1]; m = +x[2]; y = +x[3]; }
      else {
        const dt = new Date(s);
        if (isNaN(dt)) return s; // mantém o texto original se não reconhecer
        y = dt.getUTCFullYear(); m = dt.getUTCMonth() + 1; d = dt.getUTCDate();
      }
      return (Date.UTC(y, m - 1, d) - Date.UTC(1899, 11, 30)) / 86400000;
    }
    function numeroPlanilha(v){
      if (v === null || v === undefined || v === '') return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : String(v);
    }
    const textoPlanilha = v => (v === null || v === undefined || v === '') ? null : String(v);
    const FMT_DATA = 'dd/mm/yyyy';
    const FMT_MOEDA = '#,##0.00';
    const FMT_PRECO_UNID = '#,##0.0000';

    function linhasDaPlanilha(dados){
      const nomeCat = c => categorias[c] || c || null;
      const cabCompra = ['Data da compra','Marca / embalagem','Qtd','Preço unit. (R$)','Qtd na embalagem','Preço por unidade (R$)','Total (R$)','Lote','Validade','Loja','NF','Origem','EAN'];
      const fmtCompra = { 'Data da compra': FMT_DATA, 'Preço unit. (R$)': FMT_MOEDA, 'Preço por unidade (R$)': FMT_PRECO_UNID, 'Total (R$)': FMT_MOEDA, 'Validade': FMT_DATA };
      const linhaCompra = (c, variacoes) => {
        const d = c.dados;
        const qtd = numeroPlanilha(d.qtd), preco = numeroPlanilha(d.precoUnit);
        let total = numeroPlanilha(d.total);
        if (total === null && typeof qtd === 'number' && typeof preco === 'number') total = qtd * preco;
        const cont = conteudoDaCompra(d, variacoes);
        const pu = cont > 0 && typeof preco === 'number' && preco > 0 ? preco / cont : null;
        return [dataParaExcel(d.dataCompra), textoPlanilha(rotuloDaCompra(d, variacoes)), qtd, preco, cont > 0 ? cont : null, pu, total,
                textoPlanilha(d.lote), dataParaExcel(d.validade), textoPlanilha(d.loja), textoPlanilha(d.numeroNF), textoPlanilha(d.origem), textoPlanilha(d.ean)];
      };

      const materiais = {
        cabecalho: ['Nome','Categoria','Compras registradas','Última compra','Qtd da última compra','Preço unit. (R$)',
                    'Validade mais próxima','Última loja','Última NF','Última marca / embalagem','Variações','Estoque contado','Contado em',
                    'Estoque mínimo','Contar em','Na lista de compras','Marcado em','Arquivado','Tem foto','ID do material'],
        formatos: { 'Última compra': FMT_DATA, 'Preço unit. (R$)': FMT_MOEDA, 'Validade mais próxima': FMT_DATA, 'Contado em': FMT_DATA, 'Marcado em': FMT_DATA },
        linhas: dados.materiais.map(m => {
          const d = m.dados;
          return [textoPlanilha(d.nome), nomeCat(d.categoria), m.compras.length, dataParaExcel(d.ultimaCompraEm),
                  numeroPlanilha(d.quantidade), numeroPlanilha(d.precoCompra), dataParaExcel(d.validadeUltimaCompra),
                  textoPlanilha(d.lojaUltimaCompra), textoPlanilha(d.nfUltimaCompra), textoPlanilha(d.ultimaVariacao), (d.variacoes || []).length,
                  numeroPlanilha(d.contagemAtual), dataParaExcel(d.contagemEm), numeroPlanilha(d.estoqueMinimo), textoPlanilha(d.unidadeContagem),
                  d.marcadoParaCompraEm ? 'Sim' : 'Não', dataParaExcel(d.marcadoParaCompraEm), d.arquivado ? 'Sim' : 'Não', d.imagem ? 'Sim' : 'Não', m.id];
        })
      };

      const compras = { cabecalho: ['Material','Categoria', ...cabCompra, 'ID do material','ID da compra'], formatos: fmtCompra, linhas: [] };
      dados.materiais.forEach(m => m.compras.forEach(c => {
        compras.linhas.push([textoPlanilha(m.dados.nome), nomeCat(m.dados.categoria), ...linhaCompra(c, m.dados.variacoes), m.id, c.id]);
      }));

      const variacoes = {
        cabecalho: ['Material','Marca','Embalagem','Qtd na embalagem','Unidade','Reconhecida nas notas','ID do material','ID da variação'],
        formatos: {},
        linhas: []
      };
      dados.materiais.forEach(m => (m.dados.variacoes || []).forEach(v => {
        variacoes.linhas.push([textoPlanilha(m.dados.nome), textoPlanilha(v.marca), textoPlanilha(v.descricao), numeroPlanilha(v.conteudo),
                               textoPlanilha(m.dados.unidadeMedida), (v.codigos || []).length ? 'Sim' : 'Não', m.id, v.id]);
      }));

      const excluidos = {
        cabecalho: ['ID do material (excluído)', ...cabCompra, 'ID da compra'],
        formatos: fmtCompra,
        linhas: dados.comprasDeItensExcluidos.map(c => [c.materialId, ...linhaCompra(c, []), c.id])
      };
      return { materiais, compras, variacoes, excluidos };
    }

    function montarAba({ cabecalho, linhas, formatos }){
      const ws = XLSX.utils.aoa_to_sheet([cabecalho, ...linhas]);
      const colFmt = cabecalho.map(h => formatos[h]).map((f, c) => [c, f]).filter(([, f]) => f);
      linhas.forEach((linha, i) => {
        colFmt.forEach(([col, fmt]) => {
          const cel = ws[XLSX.utils.encode_cell({ r: i + 1, c: col })];
          if (cel && cel.t === 'n') cel.z = fmt;
        });
      });
      ws['!cols'] = cabecalho.map((h, c) => {
        let largura = String(h).length;
        linhas.forEach(l => { if (l[c] !== null && l[c] !== undefined) largura = Math.max(largura, String(l[c]).length); });
        return { wch: Math.min(Math.max(largura + 2, 12), 50) };
      });
      if (linhas.length) {
        ws['!autofilter'] = { ref: XLSX.utils.encode_range({ s: { r: 0, c: 0 }, e: { r: linhas.length, c: cabecalho.length - 1 } }) };
      }
      return ws;
    }

    function baixarPlanilhaBackup(){
      const abas = linhasDaPlanilha(backup.dados);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, montarAba(abas.materiais), 'Materiais');
      XLSX.utils.book_append_sheet(wb, montarAba(abas.compras), 'Compras');
      if (abas.variacoes.linhas.length) XLSX.utils.book_append_sheet(wb, montarAba(abas.variacoes), 'Marcas e embalagens');
      if (abas.excluidos.linhas.length) XLSX.utils.book_append_sheet(wb, montarAba(abas.excluidos), 'Compras de itens excluídos');
      XLSX.writeFile(wb, `backup-estoque_${backup.carimbo}.xlsx`);
    }

    function baixarArquivo(conteudo, nome, tipo){
      const blob = new Blob([conteudo], { type: tipo });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = nome;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 30000);
    }
    function carimboAgora(){
      const d = new Date(), p = n => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}_${p(d.getHours())}h${p(d.getMinutes())}`;
    }
    function tamanhoLegivel(bytes){
      if (bytes < 1048576) return Math.max(1, Math.round(bytes / 1024)) + ' KB';
      return (bytes / 1048576).toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + ' MB';
    }

    async function abrirBackup(){
      backupModal.classList.remove('hidden');
      if (backupEmAndamento) return;
      backupEmAndamento = true;
      backup = null;
      backupStatus.className = 'text-sm text-gray-700 mb-4';
      backupStatus.textContent = 'Preparando…';
      backupResumo.classList.add('hidden');
      backupAcoes.classList.add('hidden');
      btnBaixarBackupJson.textContent = 'Baixar backup completo (.json)';
      try {
        const dados = await coletarBackup(msg => { backupStatus.textContent = msg; });
        const json = JSON.stringify(dados, null, 2);
        backup = { dados, json, carimbo: carimboAgora() };
        const t = dados.totais;
        backupResumo.innerHTML = `
          <div><strong>${t.materiais}</strong> materiais (${t.materiaisComFoto} com foto${t.materiaisArquivados ? `, ${t.materiaisArquivados} arquivados` : ''})</div>
          ${t.variacoes ? `<div><strong>${t.variacoes}</strong> marcas/embalagens cadastradas</div>` : ''}
          <div><strong>${t.compras}</strong> registros de compra</div>
          ${t.comprasDeItensExcluidos ? `<div><strong>${t.comprasDeItensExcluidos}</strong> ${t.comprasDeItensExcluidos === 1 ? 'compra de um item que já foi excluído' : 'compras de itens que já foram excluídos'} <span class="text-gray-600">(continuavam guardadas no banco e também entram no backup)</span></div>` : ''}
          <div class="text-gray-600">Tamanho do arquivo: ${tamanhoLegivel(new Blob([json]).size)}</div>`;
        backupStatus.textContent = 'Backup pronto. Baixe o arquivo completo e guarde uma cópia fora deste computador (Google Drive, pendrive ou e-mail).';
        backupResumo.classList.remove('hidden');
        backupAcoes.classList.remove('hidden');
      } catch (e) {
        console.error(e);
        backupStatus.textContent = 'Não foi possível montar o backup: ' + (e && e.message ? e.message : e);
        backupStatus.className = 'text-sm text-danger-red mb-4';
      } finally {
        backupEmAndamento = false;
      }
    }

    document.getElementById('btnBackup').addEventListener('click', abrirBackup);
    document.getElementById('btnFecharBackup').addEventListener('click', () => backupModal.classList.add('hidden'));
    btnBaixarBackupJson.addEventListener('click', () => {
      if (!backup) return;
      baixarArquivo(backup.json, `backup-estoque_${backup.carimbo}.json`, 'application/json');
      btnBaixarBackupJson.textContent = '✓ Backup baixado (clique para baixar de novo)';
    });
    btnBaixarBackupXlsx.addEventListener('click', () => {
      if (!backup) return;
      try { baixarPlanilhaBackup(); }
      catch (e) {
        console.error(e);
        backupStatus.textContent = 'Falha ao gerar a planilha: ' + (e && e.message ? e.message : e);
        backupStatus.className = 'text-sm text-danger-red mb-4';
      }
    });

    // UI listeners
    document.getElementById('btnAbrirModal').addEventListener('click', abrirModal);
    document.getElementById('btnFecharModal').addEventListener('click', fecharModal);
    document.getElementById('btnFecharModalEditar').addEventListener('click', fecharModalEditar);
    document.getElementById('btnLogout').addEventListener('click', logout);
    document.getElementById('btnLimparMarcacoes').addEventListener('click', limparMarcacoes);
    document.getElementById('btnListaCompras').addEventListener('click', ()=>{
      isShowingPurchaseList=true; filtroEspecial=null; categoriaSelecionada='todos';
      document.getElementById('searchInput').value=''; termoDeBusca='';
      carregarMateriais();
    });
    document.getElementById('btnMostrarTodos').addEventListener('click', ()=>{ isShowingPurchaseList=false; filtroEspecial=null; document.getElementById('searchInput').value=''; termoDeBusca=''; categoriaSelecionada='todos'; renderizar(); });
    document.getElementById('btnCopiarLista').addEventListener('click', copiarListaCompras);
    document.getElementById('btnBuscar').addEventListener('click', buscarMateriais);
    let buscaTimer = null;
    document.getElementById('searchInput').addEventListener('input', () => { clearTimeout(buscaTimer); buscaTimer = setTimeout(buscarMateriais, 200); });
    document.getElementById('searchInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') { clearTimeout(buscaTimer); buscarMateriais(); } });
    document.getElementById('btnGerarRelatorio').addEventListener('click', gerarRelatorio);
    document.getElementById('btnAdvancedOptions').addEventListener('click', ()=>document.getElementById('advancedOptionsContainer').classList.toggle('hidden'));

    // Imprimir ficha
    document.getElementById('btnImprimirFicha').addEventListener('click', () => {
      let titulo = categoriaSelecionada === 'todos' ? 'Todas as Categorias' : (categorias[categoriaSelecionada] || categoriaSelecionada);
      if (isShowingPurchaseList) titulo = 'Lista de Compras';
      else if (filtroEspecial === 'vencendo') titulo = `Validade em até ${DIAS_ALERTA_VALIDADE} dias`;
      else if (filtroEspecial === 'abaixoMinimo') titulo = 'Abaixo do mínimo';
      else if (filtroEspecial === 'arquivados') titulo = 'Arquivados';
      document.getElementById('printTitle').innerText = `Contagem: ${titulo}`;
      window.print();
    });

    // Listeners do Modo Conferência
    document.getElementById('btnIniciarConferencia').addEventListener('click', abrirModalConferencia);
    document.getElementById('btnFecharConf').addEventListener('click', fecharModalConferencia);
    document.getElementById('btnComecarFluxo').addEventListener('click', iniciarFluxoConferencia);
    document.getElementById('btnConfComprar').addEventListener('click', () => registrarDecisao(true));
    document.getElementById('btnConfOk').addEventListener('click', () => registrarDecisao(false));
    document.getElementById('btnConfPular').addEventListener('click', pularItem);
    document.getElementById('btnConfVoltar').addEventListener('click', voltarItem);
    document.getElementById('btnConfRefazer').addEventListener('click', () => { indexItemAtual = Math.max(0, Math.min(indexItemAtual, itensParaConferir.length - 1)); alternarTelasConferencia('card'); renderizarItemAtual(); });
    document.getElementById('btnConfSalvar').addEventListener('click', salvarDadosConferencia);
    document.getElementById('btnConfInterromper').addEventListener('click', exibirResumoConferencia);

    document.addEventListener('click', (e)=>{ document.querySelectorAll('.dropdown-content').forEach(d=>{ if(!d.classList.contains('hidden') && !d.parentElement.contains(e.target)) d.classList.add('hidden'); }); });
  });

  </script>
