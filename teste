    // ---------- ARQUIVAR (em vez de excluir) ----------
    async function arquivarMaterial(id, arquivar){
      const m = acharMaterial(id); if (!m) return;
      if (arquivar) {
        const ok = await showCustomModal('Arquivar item', `Arquivar "${m.nome}"?\n\nEle sai das listas, da conferência e da ficha impressa, mas todo o histórico de compras continua guardado. Você pode desarquivar quando quiser em "Arquivados".`, 'confirm');
        if (!ok) return;
      }
      const upd = arquivar
        ? { arquivado: true, arquivadoEm: new Date().toISOString(), marcadoParaCompraEm: null }
        : { arquivado: false, arquivadoEm: null };
      try {
        await db.collection('materiais').doc(id).update(upd);
        Object.assign(m, upd);
        renderizar();
      } catch (err) { console.error(err); showCustomModal('Erro', 'Não foi possível atualizar o item: ' + err.message, 'alert'); }
    }

    async function excluirDefinitivo(id){
      const m = acharMaterial(id); if (!m) return;
      try {
        const compras = await db.collection('materiais').doc(id).collection('compras').get();
        const ok = await showCustomModal('Excluir definitivamente',
          `Excluir "${m.nome}" e ${plural(compras.size, 'registro de compra', 'registros de compra')} do histórico?\n\nEssa ação não pode ser desfeita. Se tiver dúvida, faça um backup antes.`, 'confirm');
        if (!ok) return;
        const refs = []; compras.forEach(doc => refs.push(doc.ref));
        refs.push(db.collection('materiais').doc(id));
        for (let i = 0; i < refs.length; i += 400) {
          const batch = db.batch();
          refs.slice(i, i + 400).forEach(r => batch.delete(r));
          await batch.commit();
        }
        todosMateriais = todosMateriais.filter(x => x.id !== id);
        renderizar();
      } catch (err) { console.error(err); showCustomModal('Erro', 'Falha ao excluir: ' + err.message, 'alert'); }
    }

    async function toggleComprar(id){
      const m = acharMaterial(id); if (!m) return;
      const novo = m.marcadoParaCompraEm ? null : new Date().toISOString();
      try {
        await db.collection('materiais').doc(id).update({ marcadoParaCompraEm: novo });
        m.marcadoParaCompraEm = novo;
        renderizar();
      } catch (err) { console.error(err); showCustomModal('Erro', 'Não foi possível atualizar: ' + err.message, 'alert'); }
    }

    // ---------- VARIAÇÕES (MARCAS E EMBALAGENS) ----------
    // Mantém as cópias locais em dia depois de gravar no banco
    function sincronizarMaterialLocal(materialId, campos){
      const a = acharMaterial(materialId); if (a) Object.assign(a, campos);
      const b = materiaisIndex.find(x => x.id === materialId);
      if (b) { if (campos.variacoes) b.variacoes = campos.variacoes; if (campos.codigos) b.codigos = campos.codigos; if (campos.nome) b.nome = campos.nome; }
    }
    function variacoesDoMaterial(materialId){
      const a = materiaisIndex.find(x => x.id === materialId) || acharMaterial(materialId);
      return (a && a.variacoes) || [];
    }

    async function adicionarVariacao(materialId, dados){
      const ref = db.collection('materiais').doc(materialId);
      const atual = (await ref.get()).data() || {};
      const v = { id: novoIdVariacao(), marca: (dados.marca || '').trim(), descricao: (dados.descricao || '').trim(), conteudo: dados.conteudo ?? null, codigos: [] };
      const variacoes = [...(atual.variacoes || []), v];
      await ref.update({ variacoes });
      sincronizarMaterialLocal(materialId, { variacoes });
      return v;
    }

    // Escolha feita num seletor → objeto da variação (cria se for nova)
    async function resolverVariacao(materialId, escolha){
      if (escolha.nova) return await adicionarVariacao(materialId, escolha.nova);
      if (!escolha.id) return null;
      return variacoesDoMaterial(materialId).find(v => v.id === escolha.id) || null;
    }

    function criarSeletorVariacao(container){
      container.innerHTML = `
        <select class="sv-select w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-dark focus:border-primary-dark"></select>
        <div class="sv-nova hidden grid grid-cols-1 sm:grid-cols-3 gap-2 mt-2 p-3 bg-secondary-light rounded-lg">
          <input type="text" class="sv-marca px-3 py-2 border border-gray-300 rounded-lg" placeholder="Marca (ex.: Softpaper)">
          <input type="text" class="sv-desc px-3 py-2 border border-gray-300 rounded-lg" placeholder="Embalagem (ex.: pacote 1.250 folhas)">
          <input type="number" min="0" step="any" class="sv-cont px-3 py-2 border border-gray-300 rounded-lg" placeholder="Qtd na embalagem (ex.: 1250)">
        </div>`;
      const sel = container.querySelector('.sv-select');
      const box = container.querySelector('.sv-nova');
      const marca = container.querySelector('.sv-marca'), desc = container.querySelector('.sv-desc'), cont = container.querySelector('.sv-cont');
      let sugestao = {};
      const atualizar = () => {
        const nova = sel.value === '__nova';
        box.classList.toggle('hidden', !nova);
        if (nova && !marca.value && !desc.value) { marca.value = sugestao.marca || ''; desc.value = sugestao.descricao || ''; cont.value = sugestao.conteudo ?? ''; }
      };
      sel.addEventListener('change', atualizar);
      return {
        select: sel,
        preencher(variacoes, selecionado = '', sug = {}){
          sugestao = sug || {};
          marca.value = ''; desc.value = ''; cont.value = '';
          const vs = variacoes || [];
          sel.innerHTML = `<option value="">Sem variação (não especificar marca/embalagem)</option>` +
            vs.map(v => `<option value="${esc(v.id)}">${esc(rotuloVariacao(v) || '(sem nome)')}${v.conteudo ? ` (${esc(fmtNum(v.conteudo))} por embalagem)` : ''}</option>`).join('') +
            `<option value="__nova">+ Nova marca/embalagem…</option>`;
          sel.value = (selecionado === '__nova' || vs.some(v => v.id === selecionado)) ? selecionado : '';
          atualizar();
        },
        ler(){
          if (sel.value === '__nova'){
            const dados = { marca: marca.value.trim(), descricao: desc.value.trim(), conteudo: numOpcional(cont.value) };
            if (!dados.marca && !dados.descricao) return { erro: 'Informe a marca ou a embalagem da nova variação.' };
            if (Number.isNaN(dados.conteudo)) return { erro: 'Quantidade na embalagem inválida.' };
            return { nova: dados };
          }
          return { id: sel.value || null };
        }
      };
    }

    // Rótulo e conteúdo de uma compra (usa a variação atual se existir; senão o que foi gravado na compra)
    function rotuloDaCompra(c, variacoes){
      const v = c.variacaoId ? (variacoes || []).find(x => x.id === c.variacaoId) : null;
      return v ? rotuloVariacao(v) : (c.variacao || '');
    }
    function conteudoDaCompra(c, variacoes){
      const v = c.variacaoId ? (variacoes || []).find(x => x.id === c.variacaoId) : null;
      const n = Number((v && v.conteudo) ?? c.conteudo);
      return Number.isFinite(n) ? n : 0;
    }

    // Janela "Marcas e embalagens"
