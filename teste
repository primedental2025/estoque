    // Recalcula os dados de "última compra", validade e melhor preço por unidade
    async function recomputarAgregados(id){
      const matRef = db.collection('materiais').doc(id);
      const [matSnap, compSnap] = await Promise.all([matRef.get(), matRef.collection('compras').orderBy('dataCompra', 'desc').get()]);
      const variacoes = (matSnap.exists && matSnap.data().variacoes) || [];

      let ultimaCompra = null;
      let menorValidade = null;
      let melhor = null;

      compSnap.forEach(doc => {
        const c = doc.data();
        if (!ultimaCompra) {
          ultimaCompra = c;
        }
        if(c.validade && isFuture(c.validade)){
          if(!menorValidade || new Date(c.validade) < new Date(menorValidade)) {
            menorValidade = c.validade;
          }
        }
        const cont = conteudoDaCompra(c, variacoes);
        const preco = Number(c.precoUnit);
        if (cont > 0 && preco > 0) {
          const pu = preco / cont;
          if (!melhor || pu < melhor.valor) melhor = { valor: pu, loja: c.loja || null, data: c.dataCompra || null, variacao: rotuloDaCompra(c, variacoes) || null };
        }
      });

      const agregados = {
        quantidade: ultimaCompra ? (ultimaCompra.qtd || 0) : 0,
        ultimaCompraEm: ultimaCompra ? (ultimaCompra.dataCompra ?? null) : null,
        precoCompra: ultimaCompra && ultimaCompra.precoUnit != null ? Number(ultimaCompra.precoUnit) : null,
        lojaUltimaCompra: ultimaCompra ? (ultimaCompra.loja ?? null) : null,
        nfUltimaCompra: ultimaCompra ? (ultimaCompra.numeroNF ?? null) : null,
        validadeUltimaCompra: menorValidade || null,
        ultimaVariacao: ultimaCompra ? (rotuloDaCompra(ultimaCompra, variacoes) || null) : null,
        ultimaVariacaoId: ultimaCompra ? (ultimaCompra.variacaoId || null) : null,
        melhorPrecoUnidade: melhor
      };
      await matRef.set(agregados, { merge:true });
      const m = acharMaterial(id); if (m) Object.assign(m, agregados);
      return agregados;
    }

    // ---------- IMPORTAÇÃO COM ASSISTENTE (NF-e e PLANILHA) ----------
    let importQueue = [];
    let importOrigin = null;          // 'nfe' | 'planilha'
    let importStep = 0;
    let importStats = null;
    let importRegistroNota = null;    // registro de importação anterior da mesma NF-e
    let importInicio = null;
    let materiaisIndex = [];          // materiais ativos (com variações) usados no assistente
    let indiceCodigos = new Map();    // código do produto → { materialId, variacaoId }
    let dupToken = 0;

    const nfeMatchModal = document.getElementById('nfeMatchModal');
    const btnFecharNfeMatch = document.getElementById('btnFecharNfeMatch');
    const nfeStepIdx = document.getElementById('nfeStepIdx');
    const nfeStepTotal = document.getElementById('nfeStepTotal');
    const nfeResumoAuto = document.getElementById('nfeResumoAuto');
    const nfeItemNome = document.getElementById('nfeItemNome');
    const nfeItemQtd = document.getElementById('nfeItemQtd');
    const nfeItemPreco = document.getElementById('nfeItemPreco');
    const nfeItemLote = document.getElementById('nfeItemLote');
    const nfeItemVal = document.getElementById('nfeItemVal');
    const nfeItemCodigo = document.getElementById('nfeItemCodigo');
    const nfeAviso = document.getElementById('nfeAviso');
    const nfeCandidateSelect = document.getElementById('nfeCandidateSelect');
    const nfeNovoItemBox = document.getElementById('nfeNovoItemBox');
