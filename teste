      }
    });

    function travarNfe(travar){
      nfeMatchModal.querySelectorAll('button, select, input').forEach(el => { el.disabled = travar; });
    }

    // Códigos que identificam o produto nas próximas importações
    function codigosDoItem(it, origem){
      const cods = [];
      if (it.cnpj && it.cod) cods.push(`forn:${String(it.cnpj).replace(/\D/g,'')}:${String(it.cod).trim().toUpperCase()}`);
      if (it.ean && /^\d{8,14}$/.test(it.ean)) cods.push('ean:' + it.ean);
      if (origem === 'planilha' && it.nome) cods.push('nome:' + norm(it.nome));
      return cods;
    }
    function reconhecer(it){
      for (const c of codigosDoItem(it, importOrigin)) {
        const r = indiceCodigos.get(c);
        if (r && materiaisIndex.some(m => m.id === r.materialId)) {
          const vs = variacoesDoMaterial(r.materialId);
          return { materialId: r.materialId, variacaoId: (r.variacaoId && vs.some(v => v.id === r.variacaoId)) ? r.variacaoId : null };
        }
      }
      return null;
    }
    function sugestaoVariacao(it){
      return { marca: it.marca || '', descricao: importOrigin === 'nfe' ? (it.nome || '') : '', conteudo: null };
    }

    async function carregarMateriaisIndex(){
      const s=await db.collection('materiais').get();
      materiaisIndex=[]; indiceCodigos = new Map();
      s.forEach(doc=>{
        const d=doc.data();
        if (d.arquivado) return;
        const m = { id:doc.id, nome:d.nome||doc.id, categoria:d.categoria||'', variacoes: d.variacoes || [], codigos: d.codigos || [] };
        materiaisIndex.push(m);
        m.codigos.forEach(c => indiceCodigos.set(c, { materialId: doc.id, variacaoId: null }));
        m.variacoes.forEach(v => (v.codigos || []).forEach(c => indiceCodigos.set(c, { materialId: doc.id, variacaoId: v.id })));
      });
      materiaisIndex.sort((a,b)=>String(a.nome).localeCompare(String(b.nome),'pt-BR'));
    }

    // Liga os códigos ao item/variação escolhido (e tira de onde estavam, se for outro lugar)
    async function lembrarCodigos(materialId, variacaoId, codigos){
      if (!codigos.length) return;
      const set = new Set(codigos);
      const outros = new Set();
      codigos.forEach(c => { const dono = indiceCodigos.get(c); if (dono && dono.materialId !== materialId) outros.add(dono.materialId); });
      const limpar = (d) => ({
        variacoes: (d.variacoes || []).map(v => ({ ...v, codigos: (v.codigos || []).filter(c => !set.has(c)) })),
        codigos: (d.codigos || []).filter(c => !set.has(c))
      });
      for (const outroId of outros) {
        const ref = db.collection('materiais').doc(outroId);
        const snap = await ref.get(); if (!snap.exists) continue;
        const campos = limpar(snap.data());
        await ref.update(campos);
        sincronizarMaterialLocal(outroId, campos);
      }
      const ref = db.collection('materiais').doc(materialId);
      const campos = limpar((await ref.get()).data() || {});
      if (variacaoId) campos.variacoes = campos.variacoes.map(v => v.id === variacaoId ? { ...v, codigos: [...v.codigos, ...codigos] } : v);
      else campos.codigos = [...campos.codigos, ...codigos];
      await ref.update(campos);
      sincronizarMaterialLocal(materialId, campos);
      codigos.forEach(c => indiceCodigos.set(c, { materialId, variacaoId: variacaoId || null }));
    }

    // Já existe esta compra no item? (mesma NF-e e item da nota, ou mesma NF com mesma qtd e preço)
    async function verificarDuplicata(materialId, it){
      if (!it.chave && !it.nf) return false;
      try {
        const col = db.collection('materiais').doc(materialId).collection('compras');
        let dup = false;
        if (it.chave) {
          const s1 = await col.where('chaveNFe', '==', it.chave).get();
          s1.forEach(d => { const c = d.data(); if (String(c.nItem ?? '') === String(it.nItem ?? '')) dup = true; });
          if (dup) return true;
        }
        if (it.nf) {
          const s2 = await col.where('numeroNF', '==', String(it.nf)).get();
          s2.forEach(d => {
            const c = d.data();
            if (c.chaveNFe) return;   // compras com chave já foram conferidas acima
            if (Math.abs((Number(c.qtd) || 0) - (Number(it.qtd) || 0)) < 1e-6 && Math.abs((Number(c.precoUnit) || 0) - (Number(it.preco) || 0)) < 0.011) dup = true;
          });
        }
        return dup;
      } catch (e) { console.warn('Não foi possível verificar duplicidade', e); return false; }
    }

    function abrirModalMatching(){
      nfeMatchModal.classList.remove('hidden');
      nfeStepTotal.textContent=importQueue.length;
    }

    function iniciarAssistente(itens, origem){
      importOrigin = origem;
      importQueue = itens.map(it => ({ ...it, feito: false, auto: null }));
      importQueue.forEach(it => { it.auto = reconhecer(it); });
      importStep = 0;
      importStats = { registrados: 0, automaticos: 0, pulados: 0, duplicados: 0, novosItens: 0 };
      importInicio = new Date().toISOString();
      abrirModalMatching();
      posicionar();
    }

    function posicionar(){
      while (importStep < importQueue.length && importQueue[importStep].feito) importStep++;
      if (importStep >= importQueue.length) finalizarImportacao();
      else renderMatchStep();
    }
    function avancarItem(){
      if (importQueue[importStep]) importQueue[importStep].feito = true;
      importStep++;
      posicionar();
    }
    function finalizarImportacao(){
      nfeMatchModal.classList.add('hidden');
      carregarMateriais();
      const s = importStats;
      const partes = [`${plural(s.registrados, 'compra registrada', 'compras registradas')}`];
      if (s.automaticos) partes.push(`${plural(s.automaticos, 'reconhecida', 'reconhecidas')} automaticamente`);
      if (s.novosItens) partes.push(`${plural(s.novosItens, 'item novo criado', 'itens novos criados')}`);
      if (s.duplicados) partes.push(`${plural(s.duplicados, 'já estava registrada e não foi duplicada', 'já estavam registradas e não foram duplicadas')}`);
      if (s.pulados) partes.push(`${plural(s.pulados, 'pulada', 'puladas')}`);
      showCustomModal("Importação concluída", partes.join('\n'), "alert");
    }

    function renderMatchStep(){
      const it=importQueue[importStep];
      travarNfe(false);
      nfeStepIdx.textContent=String(importStep+1);
      nfeItemNome.textContent=it.nome||'-';
      nfeItemQtd.textContent=`${fmtNum(it.qtd||0)}${it.uCom ? ' ' + it.uCom : ''}`;
      nfeItemPreco.textContent=(it.preco||0).toFixed(2).replace('.',',');
      nfeItemLote.textContent=it.lote||'-';
      nfeItemVal.textContent=it.validade ? toBRDate(it.validade) : '-';
      const cod = [];
      if (it.marca) cod.push(`Marca: ${it.marca}`);
      if (it.cod) cod.push(`Cód. fornecedor: ${it.cod}`);
      if (it.ean) cod.push(`EAN: ${it.ean}`);
      nfeItemCodigo.textContent = cod.join(' · ');

      const totalAuto = importQueue.filter(x => x.auto).length;
      nfeResumoAuto.textContent = totalAuto ? `· ${totalAuto} de ${importQueue.length} reconhecidos automaticamente` : '';
      const pendentesAuto = importQueue.slice(importStep).filter(x => !x.feito && x.auto).length;
      document.getElementById('nfeQtdReconhecidos').textContent = pendentesAuto;
      nfeBtnTodos.classList.toggle('hidden', pendentesAuto === 0);

      const sugestoes = sugerirMateriais(it.nome, materiaisIndex, 8).filter(c => c.score > 0);
      const ids = new Set(sugestoes.map(c => c.id));
      if (it.auto && !ids.has(it.auto.materialId)) {
        const a = materiaisIndex.find(m => m.id === it.auto.materialId);
        if (a) { sugestoes.unshift(a); ids.add(a.id); }
      }
      nfeCandidateSelect.innerHTML = '<option value="">— selecione no estoque —</option>' +
        (sugestoes.length ? `<optgroup label="Sugestões">${sugestoes.map(c=>`<option value="${esc(c.id)}">${esc(c.nome)}</option>`).join('')}</optgroup>` : '') +
        `<optgroup label="Todos os itens">${materiaisIndex.filter(m => !ids.has(m.id)).map(c=>`<option value="${esc(c.id)}">${esc(c.nome)}</option>`).join('')}</optgroup>`;
      nfeCandidateSelect.value = it.auto ? it.auto.materialId : '';
      nfeNovoItemBox.open = false;
      nfeNewName.value=''; nfeNewCategory.value='';
      nfeLembrar.checked = true;
      nfeLembrarBox.classList.toggle('hidden', codigosDoItem(it, importOrigin).length === 0);
      atualizarVariacaoNfe();
      checarDuplicataNfe();
    }

    function atualizarVariacaoNfe(){
      const it = importQueue[importStep]; if (!it) return;
      const id = nfeCandidateSelect.value;
      const vs = id ? variacoesDoMaterial(id) : [];
      let sel = '';
      if (it.auto && it.auto.materialId === id) sel = it.auto.variacaoId || '';
      else if (id && it.marca) { const v = vs.find(v => norm(v.marca) === norm(it.marca)); if (v) sel = v.id; }
      seletorNfe.preencher(vs, sel, sugestaoVariacao(it));
    }

    function renderAvisoNfe(duplicado){
      const it = importQueue[importStep]; if (!it) return;
      const avisos = [];
      if (it.auto && nfeCandidateSelect.value === it.auto.materialId) avisos.push('<div class="text-sm rounded-lg p-2 bg-emerald-50 text-emerald-800">✓ Reconhecido automaticamente pelas importações anteriores. Confira e clique em Registrar.</div>');
      if (duplicado) avisos.push('<div class="text-sm rounded-lg p-2 bg-amber-100 text-amber-900">⚠️ Esta compra parece já estar registrada neste item (mesma nota fiscal). Registrar de novo vai duplicar. O recomendado é <strong>Pular</strong>.</div>');
      nfeAviso.innerHTML = avisos.join('');
      nfeAviso.classList.toggle('hidden', avisos.length === 0);
    }
    async function checarDuplicataNfe(){
      const it = importQueue[importStep]; if (!it) return;
      const id = nfeCandidateSelect.value;
      const token = ++dupToken;
      renderAvisoNfe(false);
      if (!id) return;
      const dup = await verificarDuplicata(id, it);
      if (token === dupToken) renderAvisoNfe(dup);
    }

    async function marcarNotaImportada(it){
      if (importOrigin !== 'nfe' || !it.chave) return;
      await db.collection('nfesImportadas').doc(it.chave).set({
        chave: it.chave, numero: it.nf || null, loja: it.loja || null, cnpj: it.cnpj || null, emissao: it.dataCompra || null,
        importadaEm: (importRegistroNota && importRegistroNota.importadaEm) || importInicio,
        ultimaImportacaoEm: new Date().toISOString(),
        itensRegistrados: ((importRegistroNota && importRegistroNota.itensRegistrados) || 0) + importStats.registrados
      }, { merge: true });
    }
    async function registrarCompraImportada(materialId, variacao, it, automatico){
      await registrarEntradaEmMaterialExistente(materialId, it, importOrigin, variacao);
      await recomputarAgregados(materialId);
      importStats.registrados++;
      if (automatico) importStats.automaticos++;
      await marcarNotaImportada(it);
    }

    nfeBtnMesmo.addEventListener('click', async ()=>{
      const it=importQueue[importStep];
      const materialId=nfeCandidateSelect.value;
      if(!materialId){ showCustomModal("Aviso","Selecione um item do estoque ou crie um item novo.","alert"); return; }
      const escolha = seletorNfe.ler();
      if (escolha.erro) { showCustomModal('Aviso', escolha.erro, 'alert'); return; }
      travarNfe(true);
      try {
        const variacao = await resolverVariacao(materialId, escolha);
        if (nfeLembrar.checked) await lembrarCodigos(materialId, variacao ? variacao.id : null, codigosDoItem(it, importOrigin));
        const automatico = !!(it.auto && it.auto.materialId === materialId && (it.auto.variacaoId || null) === (variacao ? variacao.id : null));
        await registrarCompraImportada(materialId, variacao, it, automatico);
        avancarItem();
      } catch (e) {
        console.error(e); travarNfe(false);
        showCustomModal('Erro', 'Falha ao registrar: ' + e.message, 'alert');
      }
    });

    nfeBtnCriar.addEventListener('click', async ()=>{
      const it=importQueue[importStep];
      const nomeNovo=(nfeNewName.value||'').trim();
      const categoriaNova=nfeNewCategory.value;
      if(!nomeNovo){ showCustomModal("Aviso","Informe o nome do novo item.","alert"); return; }
      if(!categoriaNova){ showCustomModal("Aviso","Selecione a categoria.","alert"); return; }
      const escolha = seletorNfe.ler();
      if (escolha.erro) { showCustomModal('Aviso', escolha.erro, 'alert'); return; }

      travarNfe(true);
      try {
        const qSnap = await db.collection('materiais').where('nome', '==', nomeNovo).limit(1).get();
        if(!qSnap.empty){
          travarNfe(false);
          showCustomModal("Aviso",`Já existe um material chamado "${nomeNovo}". Selecione-o na lista do passo 1.`,'alert');
          return;
        }
        const newDocRef = db.collection('materiais').doc();
        await newDocRef.set(novoMaterialBase(newDocRef.id, nomeNovo, categoriaNova));
        materiaisIndex.push({ id: newDocRef.id, nome: nomeNovo, categoria: categoriaNova, variacoes: [], codigos: [] });
        materiaisIndex.sort((a,b)=>String(a.nome).localeCompare(String(b.nome),'pt-BR'));
        importStats.novosItens++;
        const variacao = escolha.nova ? await adicionarVariacao(newDocRef.id, escolha.nova) : null;
        if (nfeLembrar.checked) await lembrarCodigos(newDocRef.id, variacao ? variacao.id : null, codigosDoItem(it, importOrigin));
        await registrarCompraImportada(newDocRef.id, variacao, it, false);
        avancarItem();
      } catch (e) {
        console.error(e); travarNfe(false);
        showCustomModal('Erro', 'Falha ao criar o item: ' + e.message, 'alert');
      }
    });

    nfeBtnTodos.addEventListener('click', async () => {
      travarNfe(true);
      try {
        for (let i = importStep; i < importQueue.length; i++) {
          const it = importQueue[i];
          if (it.feito || !it.auto) continue;
          nfeResumoAuto.textContent = `· registrando ${i + 1} de ${importQueue.length}…`;
          if (await verificarDuplicata(it.auto.materialId, it)) { importStats.duplicados++; it.feito = true; continue; }
          const variacao = it.auto.variacaoId ? (variacoesDoMaterial(it.auto.materialId).find(v => v.id === it.auto.variacaoId) || null) : null;
          await registrarCompraImportada(it.auto.materialId, variacao, it, true);
          it.feito = true;
        }
      } catch (e) {
        console.error(e);
        showCustomModal('Erro', 'Falha ao registrar: ' + e.message, 'alert');
      }
      posicionar();
    });

    function stripAccents(s){ return (s||'').normalize('NFD').replace(/[̀-ͯ]/g,''); }
    function norm(s){ return stripAccents(String(s||'').toLowerCase()).replace(/[^a-z0-9\s]/g,' ').replace(/\s+/g,' ').trim();
    }
    function similarity(a,b){ a=norm(a); b=norm(b); if(!a||!b) return 0;
      const ta=new Set(a.split(' ')), tb=new Set(b.split(' '));
      const inter=[...ta].filter(x=>tb.has(x)).length;
      const uni=new Set([...ta,...tb]).size;
      let score=inter/(uni||1); if(a.includes(b)||b.includes(a)) score+=0.15; return Math.min(1,Math.max(0,score));
    }
    function sugerirMateriais(nomeNota,base,topN=5){
      const s=base.map(m=>({...m,score:similarity(nomeNota,m.nome)}));
      s.sort((x,y)=>y.score-x.score); return s.slice(0,topN);
    }

    async function onPickXmlFile(evt){
      const file=evt.target.files && evt.target.files[0];
      if(!file) return;
      try{
        await carregarMateriaisIndex();
        const xmlStr=await file.text();
        const meta = extrairMetaNfe(xmlStr);
        const itens = extrairItensDaNfe(xmlStr).map(it => ({
          ...it,
          dataCompra: meta.emissao,
          loja: meta.loja || it.loja || null,
          nf: meta.numero || it.nf || null,
          cnpj: meta.cnpj || null,
          chave: meta.chave || null
        }));
        if(!itens.length){ showCustomModal("Aviso","Não encontrei itens na NF-e.","alert"); return; }
        importRegistroNota = null;
        if (meta.chave) {
          const reg = await db.collection('nfesImportadas').doc(meta.chave).get();
          if (reg.exists) {
            importRegistroNota = reg.data();
            const ok = await showCustomModal('Nota já importada',
              `A NF ${meta.numero || ''} (${meta.loja || 'fornecedor'}) já foi importada em ${toBRDate(importRegistroNota.importadaEm)}.\n\nSe continuar, os itens que já foram registrados serão avisados para você não duplicar. Continuar?`, 'confirm');
            if (!ok) return;
          }
        }
        iniciarAssistente(itens, 'nfe');
      }catch(e){ console.error(e); showCustomModal("Erro","Falha ao processar a NF-e: "+e.message,"alert"); }
      finally{ inputXmlNfe.value='';
      }
    }

    function extrairMetaNfe(xmlStr){
      const parser=new DOMParser();
      const xml=parser.parseFromString(xmlStr,"text/xml");
      const ns="http://www.portalfiscal.inf.br/nfe";
      const t=(p,tag)=>{ const el=p && p.getElementsByTagNameNS(ns,tag)[0]; return (el && el.textContent || '').trim() || null; };
      const ide=xml.getElementsByTagNameNS(ns,'ide')[0];
      const emit=xml.getElementsByTagNameNS(ns,'emit')[0];
      const inf=xml.getElementsByTagNameNS(ns,'infNFe')[0];
      let chave = inf ? (inf.getAttribute('Id') || '').replace(/^NFe/i, '') : '';
      if (!/^\d{44}$/.test(chave)) chave = t(xml, 'chNFe') || null;
      return {
        emissao: t(ide,'dhEmi') || t(ide,'dEmi'),
        numero: t(ide,'nNF'),
        loja: t(emit,'xNome'),
        cnpj: t(emit,'CNPJ') || t(emit,'CPF'),
        chave
      };
    }

    function extrairItensDaNfe(xmlStr){
      const parser=new DOMParser();
      const xml=parser.parseFromString(xmlStr,"text/xml");
      const ns="http://www.portalfiscal.inf.br/nfe"; const dets=xml.getElementsByTagNameNS(ns,'det'); const itens=[];
      function t(p,tag){ const el=p.getElementsByTagNameNS(ns,tag)[0]; return (el && el.textContent || '').trim() || null;
      }
      for(let i=0;i<dets.length;i++){
        const det=dets[i]; const prod=det.getElementsByTagNameNS(ns,'prod')[0];
        if(!prod) continue;
        const xProd=t(prod,'xProd'); const qCom=parseFloat((t(prod,'qCom')||'0').replace(',','.'))||0;
        const vUn=parseFloat((t(prod,'vUnCom')||'0').replace(',','.'))||0; const vProd=parseFloat((t(prod,'vProd')||'0').replace(',','.'))||0;
        const cProd=t(prod,'cProd'); let ean=t(prod,'cEAN'); if(!ean || !/^\d{8,14}$/.test(ean)) ean=t(prod,'cEANTrib');
        if (ean && !/^\d{8,14}$/.test(ean)) ean = null;   // "SEM GTIN"
        const r=prod.getElementsByTagNameNS(ns,'rastro')[0]; const nLote=r?t(r,'nLote'):null;
        const dVal=r?t(r,'dVal'):null;
        itens.push({ cod:cProd, ean:ean, nome:xProd, qtd:qCom, uCom: t(prod,'uCom'), nItem: det.getAttribute('nItem') || String(i+1),
          preco:(qCom>0? vProd/qCom : vUn)||vUn, lote:nLote, validade:dVal });
      }
      return itens;
    }

    // ---------- IMPORTAÇÃO POR PLANILHA (XLSX/CSV) ----------
    const btnImportPlanilha = document.getElementById('btnImportarPlanilha');
    const inputPlanilha = document.getElementById('inputPlanilha');
    btnImportPlanilha.addEventListener('click', ()=>inputPlanilha.click());

    function excelSerialToISO(v){
      if (typeof v === 'number' && !isNaN(v)) {
        const d = new Date(Math.round((v - 25569) * 86400 * 1000));
        if (!isNaN(d)) return d.toISOString();
      }
      return null;
    }
    function parseDateFlexible(raw){
      if (raw == null || raw === '') return null;
      const serial = excelSerialToISO(raw);
      if (serial) return serial;
      if (typeof raw === 'string'){
        let s = raw.trim();
        const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
        if (m){
          const [_, d, mo, y] = m;
          const year = (y.length===2? ('20'+y) : y);
          return `${year}-${String(mo).padStart(2,'0')}-${String(d).padStart(2,'0')}T12:00:00.000Z`;
        }
        const tryD = new Date(s);
        if (!isNaN(tryD)) return tryD.toISOString();
      }
      if (raw instanceof Date && !isNaN(raw)) return raw.toISOString();
      return null;
    }
    function parseNumberFlexible(v){
      if (v == null || v === '') return NaN;
      if (typeof v === 'number') return v;
      let s = String(v).trim().replace(/\./g, '').replace(',', '.');
      const parts = s.split('.');
      if (parts.length > 2) {
        const decimal = parts.pop();
        s = parts.join('') + '.' + decimal;
      }
      const n = Number(s);
      return isNaN(n) ? NaN : n;
    }
    // Procura a coluna: primeiro nome exato, depois nome que contém o termo
    function getCell(row, candidates){
      const keys = Object.keys(row);
      const nrm = (s)=>String(s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').trim();
      for (const c of candidates){ const nc = nrm(c); for (const k of keys){ if (nrm(k) === nc) return row[k]; } }
      for (const c of candidates){ const nc = nrm(c); for (const k of keys){ if (nrm(k).includes(nc)) return row[k]; } }
      return '';
    }

    async function previewAndImport(rows){
      const previewLines = rows.slice(0, 10).map((r,i)=> `${i+1}. ${r.nome} | ${r.qtd} un | R$ ${r.preco} | ${r.dataCompra ? r.dataCompra.slice(0,10) : ''}`).join('\n');
      await showCustomModal(
        'Pré-visualização',
        rows.length ? `Primeiros registros:\n${previewLines}\n\nTotal de linhas detectadas: ${rows.length}` : 'Nenhum registro válido encontrado.',
        'alert'
      );
      if (!rows.length) return;

      await carregarMateriaisIndex();
      importRegistroNota = null;
      iniciarAssistente(rows.map(r => ({
        nome: r.nome,
        qtd: r.qtd,
        preco: r.preco,
        lote: r.lote || null,
        validade: r.validade || null,
        loja: r.loja || null,
        nf: r.nf || null,
        marca: r.marca || null,
        dataCompra: r.dataCompra || null
      })), 'planilha');
    }

    inputPlanilha.addEventListener('change', async (e)=>{
      const file = e.target.files && e.target.files[0];
      if(!file) return;
      try{
        const isCsv = /\.csv$/i.test(file.name);
        let rows = [];

        if (isCsv){
          const text = await file.text();
          let delim = text.includes(';') ? ';' : ',';
          const lines = text.split(/\r?\n/).filter(l => l.trim().length);
          if (!lines.length) throw new Error('CSV vazio');
          const header = lines[0].replace(/^﻿/, '').split(delim).map(h => h.trim());
          for (let i=1; i<lines.length; i++){
            const cols = lines[i].split(delim);
            let row = {};
            header.forEach((h,idx)=> row[h] = (cols[idx]||'').trim());
            rows.push(row);
          }
        } else {
          const data = await file.arrayBuffer();
          const wb = XLSX.read(data, { type:'array', cellDates:true, raw:false });
          let ws = null;
          for (const name of wb.SheetNames){
            const sheet = wb.Sheets[name];
            const json = XLSX.utils.sheet_to_json(sheet, { defval:'' });
            if (json && json.length){ ws = sheet; break; }
          }
          if (!ws) throw new Error('Nenhuma aba com dados encontrada.');
          rows = XLSX.utils.sheet_to_json(ws, { defval:'' });
        }

        const parsed = [];
        for (const raw of rows){
          const nomeItem = String(getCell(raw, ['Nome do item','Nome','Produto','Item'])).trim();
          if (!nomeItem) continue;

          const dataCompraRaw = getCell(raw, ['Data de compra','Data da compra','Data_compra','Data']);
          const qtdRaw        = getCell(raw, ['Quantidade','Qtd','Qte']);
          const precoRaw      = getCell(raw, ['Preço unitário','Preco unitario','Preço unit','Preço','Preco','Valor unitário','Valor']);
          const validadeRaw   = getCell(raw, ['Validade','Vencimento','Data de validade']);
          const loteRaw       = getCell(raw, ['Lote','Lote/Batch']);
          const lojaRaw       = getCell(raw, ['Loja','Estabelecimento','Fornecedor']);
          const nfRaw         = getCell(raw, ['Número da Nota Fiscal','Numero da Nota Fiscal','NF','NFe','Numero NF','Chave']);
          const marcaRaw      = getCell(raw, ['Marca','Fabricante']);
          const qtd   = parseNumberFlexible(qtdRaw);
          const preco = parseNumberFlexible(precoRaw);
          const dataCompra = parseDateFlexible(dataCompraRaw);
          const validade   = parseDateFlexible(validadeRaw);
          if (isNaN(qtd) || qtd <= 0) continue;

          parsed.push({
            nome: nomeItem,
            qtd,
            preco: isNaN(preco) ? 0 : preco,
            dataCompra,
            validade,
            lote: (loteRaw || '').toString().trim() || null,
            loja: (lojaRaw || '').toString().trim() || null,
            nf: (nfRaw || '').toString().trim() || null,
            marca: (marcaRaw || '').toString().trim() || null
          });
        }

        await previewAndImport(parsed);
      }catch(err){
        console.error('Erro na importação da planilha:', err);
        await showCustomModal('Erro na importação', (err && err.message) ? err.message : String(err), 'alert');
      } finally {
        e.target.value='';
      }
    });

    // ---------- MESCLAR ITENS ----------
    const mesclarModal = document.getElementById('mesclarModal');
    const mesclarDestino = document.getElementById('mesclarDestino');
    let mesclarCtx = { origemId: null, nCompras: 0 };

    async function abrirMesclar(id){
      const m = acharMaterial(id); if (!m) return;
      mesclarCtx = { origemId: id, nCompras: 0 };
      document.getElementById('mesclarOrigemNome').textContent = m.nome;
      document.getElementById('mesclarOrigemCompras').textContent = 'contando compras…';
      const outros = todosMateriais.filter(x => !x.arquivado && x.id !== id);
      const sugestoes = sugerirMateriais(m.nome, outros, 5).filter(c => c.score > 0);
      const ids = new Set(sugestoes.map(c => c.id));
      mesclarDestino.innerHTML = '<option value="">— escolha o item que vai ficar —</option>' +
        (sugestoes.length ? `<optgroup label="Parecidos">${sugestoes.map(c => `<option value="${esc(c.id)}">${esc(c.nome)}</option>`).join('')}</optgroup>` : '') +
        `<optgroup label="Todos os itens">${outros.filter(x => !ids.has(x.id)).sort((a,b)=>String(a.nome).localeCompare(String(b.nome),'pt-BR')).map(c => `<option value="${esc(c.id)}">${esc(c.nome)}</option>`).join('')}</optgroup>`;
      document.getElementById('mesclarMarca').value = '';
      document.getElementById('mesclarDescricao').value = m.nome;
      document.getElementById('mesclarConteudo').value = '';
      mesclarModal.classList.remove('hidden');
      try {
        const snap = await db.collection('materiais').doc(id).collection('compras').get();
        mesclarCtx.nCompras = snap.size;
        document.getElementById('mesclarOrigemCompras').textContent = plural(snap.size, 'compra registrada', 'compras registradas');
      } catch (e) { console.error(e); document.getElementById('mesclarOrigemCompras').textContent = 'não foi possível contar as compras'; }
    }

    async function confirmarMesclar(){
      const origemId = mesclarCtx.origemId;
      const destinoId = mesclarDestino.value;
      if (!destinoId) { showCustomModal('Aviso', 'Escolha o item de destino.', 'alert'); return; }
      const marca = document.getElementById('mesclarMarca').value.trim();
      const descricao = document.getElementById('mesclarDescricao').value.trim();
      const conteudo = numOpcional(document.getElementById('mesclarConteudo').value);
      if (Number.isNaN(conteudo)) { showCustomModal('Aviso', 'Quantidade na embalagem inválida.', 'alert'); return; }
      const origem = acharMaterial(origemId), destino = acharMaterial(destinoId);
      const ok = await showCustomModal('Confirmar mesclagem',
        `"${origem.nome}" será incorporado a "${destino.nome}".\n\n${plural(mesclarCtx.nCompras, 'compra será transferida', 'compras serão transferidas')} e "${origem.nome}" deixa de existir como item separado. Continuar?`, 'confirm');
      if (!ok) return;

      const btn = document.getElementById('btnConfirmarMesclar'); btn.disabled = true;
      try {
        const origemRef = db.collection('materiais').doc(origemId);
        const destinoRef = db.collection('materiais').doc(destinoId);
        const [oSnap, dSnap, comprasSnap] = await Promise.all([origemRef.get(), destinoRef.get(), origemRef.collection('compras').get()]);
        if (!oSnap.exists || !dSnap.exists) throw new Error('Um dos itens não foi encontrado. Recarregue a página.');
        const o = oSnap.data(), d = dSnap.data();

        const novaVar = (marca || descricao) ? { id: novoIdVariacao(), marca, descricao, conteudo, codigos: [...(o.codigos || [])] } : null;
        const upd = {
          variacoes: [...(d.variacoes || []), ...(o.variacoes || []), ...(novaVar ? [novaVar] : [])],
          codigos: novaVar ? (d.codigos || []) : [...new Set([...(d.codigos || []), ...(o.codigos || [])])],
          ultimaModificacao: new Date().toLocaleString('pt-BR')
        };
        if (!d.imagem && o.imagem) upd.imagem = o.imagem;
        if (!d.marcadoParaCompraEm && o.marcadoParaCompraEm) upd.marcadoParaCompraEm = o.marcadoParaCompraEm;

        const copias = [], apagar = [];
        comprasSnap.forEach(doc => {
          const c = doc.data();
          const nova = { ...c, mescladoDe: origemId, mescladoDeNome: o.nome || null };
          if (!c.variacaoId && novaVar) { nova.variacaoId = novaVar.id; nova.variacao = rotuloVariacao(novaVar) || null; nova.conteudo = novaVar.conteudo ?? null; }
          copias.push([destinoRef.collection('compras').doc(doc.id), nova]);
          apagar.push(doc.ref);
        });

        const totalOps = 2 + copias.length * 2;
        if (totalOps <= 490) {
          // Tudo de uma vez: ou grava tudo, ou nada
          const batch = db.batch();
          batch.update(destinoRef, upd);
          copias.forEach(([ref, dados]) => batch.set(ref, dados));
          apagar.forEach(ref => batch.delete(ref));
          batch.delete(origemRef);
          await batch.commit();
        } else {
          // Muitos registros: primeiro copia, confere, e só então apaga o original
          for (let i = 0; i < copias.length; i += 400) {
            const batch = db.batch();
            copias.slice(i, i + 400).forEach(([ref, dados]) => batch.set(ref, dados));
            await batch.commit();
          }
          const conferencia = await destinoRef.collection('compras').where('mescladoDe', '==', origemId).get();
          if (conferencia.size < copias.length) throw new Error('A cópia do histórico não conferiu. Nada foi apagado do item original.');
          await destinoRef.update(upd);
          const refs = [...apagar, origemRef];
          for (let i = 0; i < refs.length; i += 400) {
            const batch = db.batch();
            refs.slice(i, i + 400).forEach(ref => batch.delete(ref));
            await batch.commit();
          }
        }
        mesclarModal.classList.add('hidden');
        await recomputarAgregados(destinoId);
        await carregarMateriais();
        showCustomModal('Itens mesclados', `"${o.nome}" agora faz parte de "${d.nome}".`, 'alert');
      } catch (err) {
        console.error(err);
        showCustomModal('Erro', 'Falha ao mesclar: ' + err.message, 'alert');
      } finally { btn.disabled = false; }
    }
    document.getElementById('btnFecharMesclar').addEventListener('click', () => mesclarModal.classList.add('hidden'));
    document.getElementById('btnCancelarMesclar').addEventListener('click', () => mesclarModal.classList.add('hidden'));
