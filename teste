    const confDica = document.getElementById('confDica');

    function abrirModalConferencia() {
      document.getElementById('modalConferencia').classList.remove('hidden');
      document.getElementById('confMsgSelecao').textContent = '';
      alternarTelasConferencia('selecao');
    }
    function fecharModalConferencia() {
      document.getElementById('modalConferencia').classList.add('hidden');
      itensParaConferir = [];
      respostasConferencia = [];
