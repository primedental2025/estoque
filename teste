    const nfeBtnPular = document.getElementById('nfeBtnPular');
    const nfeBtnTodos = document.getElementById('nfeBtnTodos');
    const btnImportarNfe = document.getElementById('btnImportarNfe');
    const inputXmlNfe = document.getElementById('inputXmlNfe');
    const seletorNfe = criarSeletorVariacao(document.getElementById('nfeVarBox'));

    btnImportarNfe.addEventListener('click',()=>inputXmlNfe.click());
    inputXmlNfe.addEventListener('change', onPickXmlFile);

    btnFecharNfeMatch.addEventListener('click',()=>{
      nfeMatchModal.classList.add('hidden');
      if (importStats && importStats.registrados) carregarMateriais();
    });
    nfeBtnPular.addEventListener('click',()=>{ importStats.pulados++; avancarItem(); });
    nfeCandidateSelect.addEventListener('change', () => { atualizarVariacaoNfe(); checarDuplicataNfe(); });
    nfeNovoItemBox.addEventListener('toggle', () => {
      const it = importQueue[importStep]; if (!it) return;
      if (nfeNovoItemBox.open) {
        dupToken++;
