    });
    document.getElementById('btnCancelarVariacao').addEventListener('click', resetFormVariacao);
    document.getElementById('btnFecharVariacoes').addEventListener('click', () => { variacoesModal.classList.add('hidden'); renderizar(); });
    variacoesUnidadeMedida.addEventListener('change', async () => {
      const unidadeMedida = variacoesUnidadeMedida.value.trim() || null;
      try {
        await db.collection('materiais').doc(variacoesCtx.id).update({ unidadeMedida });
