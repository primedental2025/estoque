    variacaoForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const dados = { marca: variacaoMarca.value.trim(), descricao: variacaoDescricao.value.trim(), conteudo: numOpcional(variacaoConteudo.value) };
      if (!dados.marca && !dados.descricao) { showCustomModal('Aviso', 'Informe a marca ou a embalagem.', 'alert'); return; }
      if (Number.isNaN(dados.conteudo)) { showCustomModal('Aviso', 'Quantidade na embalagem inválida.', 'alert'); return; }
      const editId = variacaoEditId.value;
      try {
        await alterarVariacoes(variacoesCtx.id, vs => editId
